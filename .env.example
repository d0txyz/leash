# Copy to .env.local, or let `npm run setup:testnet` write .env.local for you.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com
NEXT_PUBLIC_VAULT_ID=vault.<root>.testnet
NEXT_PUBLIC_AGENT_ID=agent.<root>.testnet
# Owner and deployer. Local only: never put this on a server.
ROOT_ACCOUNT_ID=
ROOT_PRIVATE_KEY=
# The agent's function-call key (can only call vault.request_spend). The web server needs these.
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=
# Optional: run the agent on NEAR AI Cloud instead of the scripted agent.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=Qwen/Qwen3.8-27B

# Optional, hosted demo only: reset-only key on the owner account (npm run owner -- add-reset-key)
DEMO_RESET_ACCOUNT_ID=
DEMO_RESET_PRIVATE_KEY=
